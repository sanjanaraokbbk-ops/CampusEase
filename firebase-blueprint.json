{
  "entities": {
    "Product": {
      "title": "Product",
      "description": "An everyday campus essential listed in the CampusEase catalog.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 2,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "name": {
          "type": "string",
          "minLength": 2,
          "maxLength": 120
        },
        "category": {
          "type": "string",
          "enum": [
            "Stationery",
            "Snacks & Beverages",
            "Personal Care",
            "Medicines & First Aid"
          ]
        },
        "price": {
          "type": "number"
        },
        "unit": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "description": {
          "type": "string",
          "minLength": 5,
          "maxLength": 500
        },
        "image": {
          "type": "string",
          "minLength": 1,
          "maxLength": 250
        },
        "available": {
          "type": "boolean"
        },
        "popular": {
          "type": "boolean"
        },
        "otcNotice": {
          "type": "boolean"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "name",
        "category",
        "price",
        "unit",
        "description",
        "image",
        "available",
        "updatedAt"
      ]
    },
    "StudentProfile": {
      "title": "StudentProfile",
      "description": "Private profile and default DBS Global University location for an authenticated student.",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 2,
          "maxLength": 100
        },
        "studentId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "program": {
          "type": "string",
          "minLength": 2,
          "maxLength": 120
        },
        "mobile": {
          "type": "string",
          "pattern": "^[0-9]{10}$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "minLength": 5,
          "maxLength": 120
        },
        "defaultLocation": {
          "type": "string",
          "minLength": 2,
          "maxLength": 150
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "name",
        "studentId",
        "program",
        "mobile",
        "email",
        "defaultLocation",
        "createdAt",
        "updatedAt"
      ]
    },
    "Order": {
      "title": "Order",
      "description": "A CampusEase demonstration order placed by a verified student with hostel or pickup-point fulfillment.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 4,
          "maxLength": 32,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "studentName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 100
        },
        "mobile": {
          "type": "string",
          "pattern": "^[0-9]{10}$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "minLength": 5,
          "maxLength": 120
        },
        "location": {
          "type": "string",
          "minLength": 2,
          "maxLength": 150
        },
        "fulfillmentMethod": {
          "type": "string",
          "enum": ["hostel_delivery", "campus_pickup"]
        },
        "notes": {
          "type": "string",
          "maxLength": 400
        },
        "items": {
          "type": "array",
          "description": "Bounded list (1-20) of ordered product line items."
        },
        "subtotal": {
          "type": "number"
        },
        "convenienceFee": {
          "type": "number"
        },
        "total": {
          "type": "number"
        },
        "status": {
          "type": "string",
          "enum": [
            "Order Placed",
            "Preparing",
            "Ready for Pickup",
            "Completed"
          ]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "userId",
        "studentName",
        "mobile",
        "email",
        "location",
        "fulfillmentMethod",
        "notes",
        "items",
        "subtotal",
        "convenienceFee",
        "total",
        "status",
        "createdAt",
        "updatedAt"
      ]
    },
    "ServiceBooking": {
      "title": "ServiceBooking",
      "description": "A campus service booking request submitted by a verified student.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 4,
          "maxLength": 32,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "serviceId": {
          "type": "string",
          "minLength": 2,
          "maxLength": 40,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "serviceName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 120
        },
        "servicePrice": {
          "type": "number"
        },
        "servicePriceUnit": {
          "type": "string",
          "minLength": 2,
          "maxLength": 60
        },
        "preferredDate": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "preferredTime": {
          "type": "string",
          "minLength": 3,
          "maxLength": 40
        },
        "studentName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 100
        },
        "mobile": {
          "type": "string",
          "pattern": "^[0-9]{10}$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "minLength": 5,
          "maxLength": 120
        },
        "location": {
          "type": "string",
          "minLength": 2,
          "maxLength": 150
        },
        "notes": {
          "type": "string",
          "maxLength": 400
        },
        "status": {
          "type": "string",
          "enum": ["Requested", "Confirmed", "In Progress", "Completed"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "userId",
        "serviceId",
        "serviceName",
        "servicePrice",
        "servicePriceUnit",
        "preferredDate",
        "preferredTime",
        "studentName",
        "mobile",
        "email",
        "location",
        "notes",
        "status",
        "createdAt",
        "updatedAt"
      ]
    },
    "AdminRecord": {
      "title": "AdminRecord",
      "description": "Trusted admin identity document managed out-of-band.",
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "format": "email",
          "minLength": 5,
          "maxLength": 120
        }
      },
      "required": ["email"]
    }
  },
  "firestore": {
    "/products/{productId}": {
      "schema": { "$ref": "#/entities/Product" },
      "description": "CampusEase catalog products and live stock availability."
    },
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/StudentProfile" },
      "description": "Private student profile documents isolated to owner and verified admins."
    },
    "/orders/{orderId}": {
      "schema": { "$ref": "#/entities/Order" },
      "description": "Student essentials orders with bounded items and simulated fulfillment statuses."
    },
    "/bookings/{bookingId}": {
      "schema": { "$ref": "#/entities/ServiceBooking" },
      "description": "Campus service booking requests scheduled by students."
    },
    "/admins/{adminId}": {
      "schema": { "$ref": "#/entities/AdminRecord" },
      "description": "Read-only trusted administrator registry."
    }
  }
}
